insert into `jobs` values("22","1921/9122 | Nowra Mixed Goods","<p><u>1921 | Down Goods train from Clyde Yard to Nowra</u></p><p><em>Scheduled Departure Time: 0600</em></p><p><strong>Clyde Yard (Staging)</strong></p><ul><li>Acquire train in Balloon loop staging yard</li><li>Ensure train complete and EOT Device present</li></ul><p><strong>Kiama</strong></p><ul><li>Request permission to retrieve staff at Kiama</li></ul><h4>Berry</h4><ul><li>Request permission to sink/retrieve staffs at Berry</li></ul><h4>Nowra</h4><ul><li>Nowra is a Yard Working location.</li><li>Drop any cars destined for Kembla Heights or Berry to the No. 2 Goods Siding</li><li>Pickup any cars destined for Clyde Yard within Nowra Yard</li><li>Once work is complete, stable train in No. 1 Goods Siding</li></ul><p><strong>Forms 9122 at 1530<br /></strong></p>
<p><u>9122 | Up Goods train from Nowra to Clyde Yard</u></p><p><em>Scheduled Departure Time: 1530</em></p><h4>Nowra</h4><ul><li>Nowra is a Yard Working location.</li><li>Pickup Train in No.1 Goods Siding</li><li>Ensure train complete and EOT Device present</li><li>Contact Dispatcher to request staff</li></ul><h4>Berry</h4><ul><li>Request permission to sink/retrieve staffs at Berry</li></ul><p><strong>Kiama</strong></p><ul><li>Request permission to sink staff at Kiama</li></ul><p><strong>Clyde Yard (Staging)</strong></p><ul><li>Stable train in Balloon Loop Staging Yard</li></ul><p><strong>Train does not form a new service</strong></p>

