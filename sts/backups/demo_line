insert into `jobs` values("20","1121/1122 | Kembla Heights Trip Train","<p><u>1121 | Down Trip Train from Rozelle to Kembla Heights</u></p><p><em>Scheduled Departure Time: 1330 </em></p><p><strong>Staging (Rozelle)<br /></strong></p><ul><li>Ensure train complete and EOT Device present</li><li>Dispatcher will contact you for path shortly before scheduled departure time</li></ul><p><strong>Kembla Junction<br /></strong></p><ul><li>Dispatcher will handle shunt signals to run around train </li></ul><p><strong>Kembla Heights</strong></p><ul><li>Yard working location within signal limits</li><li>Contact Dispatcher if you require Signal KH1 to shunt onto the main line.</li><li>Use chocks to stable your train on the grade if necessary.</li></ul><p><strong>Forms 1122 at 1805<br /></strong></p>
<p><u>1122 | Up Trip Train from Kembla Heights to Rozelle</u></p><p><em>Scheduled Departure Time: 1805 </em></p><p><strong>Kembla Heights</strong></p><ul><li>Ensure train complete and EOT Device present</li><li>Dispatcher will contact you for path shortly before scheduled departure time</li></ul><p><strong>Kembla Junction<br /></strong></p><ul><li>Dispatcher will handle shunt signals to run around train </li></ul><p><strong>Staging (Rozelle)</strong></p><ul><li>Stable in Dead-End Siding in Staging</li></ul><p><strong>Train does not form a new service<br /></strong></p>");
