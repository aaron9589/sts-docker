insert into `jobs` values("21","1124/1123 | Kembla Heights Pickup Goods","<p><u>1124 | Pickup Goods from Nowra to Kembla Heights</u></p><p><em>Scheduled Departure Time: 0400 </em></p><p><strong>Nowra<br /></strong></p><ul><li>Assemble your train for departure. Review your assigned cars and make up your train.</li><li>Contact Dispatcher when ready to depart. Request permission to retrieve staff at Nowra</li><li>Cars destined for Berry via 1123 should also be attached</li></ul><p><strong>Berry</strong></p><ul><li>Request permission to sink/retrieve staffs at Berry</li></ul><p><strong>Kiama</strong></p><ul><li>Request permission to sink staff at Kiama</li></ul><p><strong>Kembla Heights</strong></p><ul><li>Yard working location within signal limits</li><li>Contact Dispatcher if you require Signal KH1 to shunt onto the main line.</li><li>Use chocks to stable your train on the grade if necessary.</li><li>Drop any wagons destined for Berry in STS at Kembla Heights Yard. These will be picked up by 1123.</li></ul><p><strong>Form 1123 at 1150 hours</strong></p>
<p><u>1123 | Pickup Goods from Kembla Heights to Nowra</u></p><p><em>Scheduled Departure Time: 1150</em></p><p><strong>Kembla Heights</strong></p><ul><li>Retrieve any cars from Kembla Heights. This will include cars destined for Berry, which should have been dropped off by 1124 in Kembla Heights Yard.</li><li>Contact Dispatcher 5 mins before scheduled departure to confirm path.</li></ul><p><strong>Kiama</strong></p><ul><li>Request permission to retrieve staff at Kiama</li></ul><h4>Berry</h4><ul><li>Switch any cars for Berry Cement Siding.</li><li>Request permission to sink/retrieve staffs at Berry</li></ul><h4>Nowra</h4><ul><li>Do not stable in the loop.</li><li>Shunt any cars destined for Nowra to their respective sidings</li><li>Leave any cars destined for Clyde in a siding ready for pickup.</li><li>Shutdown the engine in the same siding.</li></ul><p><strong>Train does not form a new service</strong></p>");
